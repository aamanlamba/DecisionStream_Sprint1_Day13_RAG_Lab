# Copy to .env and fill in. .env is git-ignored; this file is not.
#
#   cp .env.example .env
#
# mock  = deterministic scoring, offline, free, reproducible  (default)
# azure = a real Azure OpenAI deployment generates and judges  (costs money)
RAGAS_JUDGE=mock

AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-key>
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=<your-chat-deployment-name>

RAGAS_JUDGE_TEMPERATURE=0.0
RAGAS_MAX_CALLS=400
